# TEMPLATE ONLY. No credentials, tokens, passwords or real destinations belong here.
# Copy outside Git to a protected operator-controlled location; fill only approved values.
# Images must be reviewed immutable references already available locally; no automatic pull/build.
HEALTH_BACKEND_IMAGE=
HEALTH_GATEWAY_IMAGE=

# Exclusive external SQL Server 2022 database; certificate SAN must match the server hostname.
HEALTH_SQLSERVER_SERVER=
HEALTH_SQLSERVER_PORT=1433
HEALTH_SQLSERVER_DATABASE=
HEALTH_SQLSERVER_RUNTIME_USER=

# Public DNS name without scheme/path/wildcards and exact HTTPS origin of that base domain.
HEALTH_BASE_DOMAIN=
HEALTH_PUBLIC_ORIGIN=

# Gateway binds this host's IPv4 loopback only; the HTTPS terminator is provisioned separately.
HEALTH_GATEWAY_PORT=18080

# File PATHS only: protected files outside the repository and image build context.
# SQL password file is mounted as /run/secrets/health.sqlserver.runtime.password.
# JWT key file is mounted as /run/secrets/HEALTH_JWT_SECRET; >=32 UTF-8 bytes, no newline.
# Use the same key across replicas/restarts; key rotation needs a separate reviewed session plan.
HEALTH_SQL_PASSWORD_FILE=
HEALTH_JWT_SECRET_FILE=
